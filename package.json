{
  "name": "court-calendar",
  "private": true,
  "version": "1.0.0",
  "description": "裁判の期日を共有するカレンダー（Cloudflare Pages + Functions + D1 + Access）",
  "scripts": {
    "db:init:local": "wrangler d1 execute court-calendar --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute court-calendar --remote --file schema.sql",
    "db:migrate:local": "wrangler d1 execute court-calendar --local --file migrate_002_call_for_support.sql",
    "db:migrate:remote": "wrangler d1 execute court-calendar --remote --file migrate_002_call_for_support.sql",
    "db:board:local": "wrangler d1 execute court-calendar --local --file migrate_003_board.sql",
    "db:board:remote": "wrangler d1 execute court-calendar --remote --file migrate_003_board.sql",
    "db:seed:local": "wrangler d1 execute court-calendar --local --file seed_sample.sql",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy",
    "db:cases:local": "wrangler d1 execute court-calendar --local --file migrate_004_cases.sql",
    "db:cases:remote": "wrangler d1 execute court-calendar --remote --file migrate_004_cases.sql",
    "db:backup:remote": "wrangler d1 export court-calendar --remote --output backup_remote.sql",
    "r2:create": "wrangler r2 bucket create court-calendar-files"
  },
  "devDependencies": {
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "react": "^19.2.8"
  }
}
